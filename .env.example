# ---- runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true

# ---- postgres ---------------------------------------------------------------
DATABASE_URL=postgresql://tournament:tournament@localhost:5432/tournament
# Connections the pool may open. Defaults to RABBITMQ_PREFETCH + 5: a delivery
# is handled in a transaction, so a smaller pool makes handlers queue for
# connections and throughput drops with nothing in the logs to say why.
# DATABASE_POOL_MAX=25

# ---- rabbitmq ---------------------------------------------------------------
RABBITMQ_URL=amqp://tournament:tournament@localhost:5672
# How many unacked messages one consumer holds at a time.
RABBITMQ_PREFETCH=20
# Delivery attempts before a message is parked in the dead-letter queue.
RABBITMQ_MAX_ATTEMPTS=5
# How long a failed message waits in the retry queue before coming back.
RABBITMQ_RETRY_TTL_MS=10000

# ---- tracing ----------------------------------------------------------------
# Spans are always created and the trace context always propagates, so logs
# carry a trace id either way. An endpoint adds somewhere to look at the trace;
# docker compose brings up Jaeger on http://localhost:16686 for that.
OTEL_SERVICE_NAME=bet-tournament
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_ENABLED=false

# ---- scoring ----------------------------------------------------------------
# Units of USD per 1 unit of the currency. USD is hardcoded to 1 and must not
# be listed here. A currency missing from this map parks the bet.settled event
# instead of silently scoring it as zero.
FX_RATES={"EUR":1.08,"GBP":1.27,"UAH":0.024}

# ---- tournament -------------------------------------------------------------
# The active tournament. The config is the source of truth: the row is upserted
# by code on boot. starts_at is inclusive, ends_at is exclusive.
TOURNAMENT_CODE=nov-2026
TOURNAMENT_STARTS_AT=2026-11-01T00:00:00.000Z
TOURNAMENT_ENDS_AT=2026-12-01T00:00:00.000Z
